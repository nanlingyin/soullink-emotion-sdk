# Server-side provider configuration for the local demo.
# Keep this file free of real credentials. Copy it to .env or configure the
# variables in your deployment secret manager; never expose them as VITE_*.

# Text / conversation model (OpenAI-compatible)
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
SOULLINK_LLM_MODEL=provider/chat-model
SOULLINK_EMBEDDING_MODEL=provider/embedding-model

# Optional dedicated conversation model. It falls back to OPENAI_* above.
RIVO_BASE_URL=https://api.example.com/v1
RIVO_API_KEY=
RIVO_MODEL=provider/chat-model

# Optional independent JEV / speaking-motion model
JEV_BASE_URL=https://api.example.com/v1
JEV_API_KEY=
JEV_MODEL=provider/jev-model

# Optional voice model
FISH_BASE_URL=https://api.example.com/v1
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=voice-model

# Local Demo assets. The directory should contain models/ and optional
# jev-replays/. Production builds exclude it unless explicitly opted in.
SOULLINK_DEMO_PUBLIC_DIR=apps/web/public
SOULLINK_INCLUDE_MODEL_ASSETS=0
